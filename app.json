{
  "expo": {
    "name": "Pocket Quartermaster",
    "slug": "pocket-quartermaster",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4EAD2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.barrywype.pocketquartermaster"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pocket Quartermaster uses your location to show nearby resources."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Pocket Quartermaster counts your steps to unlock daily chests."
        }
      ]
    ],
    "scheme": "pocketquartermaster",
    "experiments": {
      "typedRoutes": true
    }
  }
}
