{
  "name": "pocket-quartermaster",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/alegreya": "^0.4.2",
    "@mapbox/vector-tile": "^1.3.1",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-sensors": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.13",
    "ngeohash": "^0.6.4",
    "pbf": "^3.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-freeze": "1.0.4",
    "react-native": "0.88.1",
    "react-native-pager-view": "9.0.7",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "seedrandom": "^3.0.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@swc/core": "^1.16.21",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/mapbox__vector-tile": "^1.3.4",
    "@types/ngeohash": "^0.6.8",
    "@types/pbf": "^3.0.5",
    "@types/react": "~19.3.0",
    "@types/seedrandom": "^3.0.8",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "react-test-renderer": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:fresh": "expo prebuild --platform android --clean && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --selectProjects logic app",
    "test:all": "jest",
    "test:logic": "jest --selectProjects logic",
    "test:app": "jest --selectProjects app",
    "test:perf": "jest --selectProjects perf",
    "test:sim": "jest --selectProjects sim",
    "test:changed": "jest -o --selectProjects logic app",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "sim": "node scripts/sim/build.mjs && node sim-output/.build/sim.cjs",
    "sim:quick": "node scripts/sim/build.mjs && node sim-output/.build/quick.cjs",
    "sim:check": "npm run sim && SIM_CHECK=1 jest src/game/sim/bands.test.ts",
    "sim:fit": "node scripts/sim/build.mjs && node sim-output/.build/fit.cjs",
    "sim:specials": "node scripts/sim/build.mjs && node sim-output/.build/specials.cjs",
    "loot:matrix": "tsx scripts/loot/genMatrix.ts"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "logic",
        "testEnvironment": "node",
        "transform": {
          "^.+\\.(t|j)sx?$": [
            "@swc/jest",
            {
              "jsc": {
                "parser": {
                  "syntax": "typescript",
                  "tsx": true
                },
                "target": "es2022"
              },
              "module": {
                "type": "commonjs"
              }
            }
          ],
          "^.+\\.(png|jpg|jpeg|gif|webp|svg|bmp|avif|heic|ttf|otf|woff|woff2|mp3|wav|m4a|mp4|pdf|html)$": "jest-expo/src/preset/assetFileTransformer.js"
        },
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        },
        "testMatch": [
          "<rootDir>/src/game/**/*.test.ts",
          "<rootDir>/src/game/**/*.test.tsx",
          "<rootDir>/src/content/**/*.test.ts",
          "<rootDir>/src/content/**/*.test.tsx"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/\\.worktrees/",
          "<rootDir>/src/game/sim/sim\\.test\\.ts$",
          "<rootDir>/src/game/sim/quick\\.test\\.ts$",
          "<rootDir>/src/game/expeditions/oddsPerf\\.test\\.ts$",
          "<rootDir>/src/game/save/uniqueUids\\.test\\.ts$",
          "<rootDir>/src/game/patrols/pocketPassive\\.test\\.ts$",
          "<rootDir>/src/game/expeditions/oddsCache\\.test\\.ts$",
          "<rootDir>/src/game/expeditions/odds\\.test\\.ts$"
        ]
      },
      {
        "displayName": "app",
        "preset": "jest-expo",
        "setupFiles": [
          "./jest.setup.ts"
        ],
        "testMatch": [
          "<rootDir>/src/app/**/*.test.ts",
          "<rootDir>/src/app/**/*.test.tsx",
          "<rootDir>/src/components/**/*.test.ts",
          "<rootDir>/src/components/**/*.test.tsx",
          "<rootDir>/src/store/**/*.test.ts",
          "<rootDir>/src/store/**/*.test.tsx",
          "<rootDir>/src/services/**/*.test.ts",
          "<rootDir>/src/services/**/*.test.tsx",
          "<rootDir>/src/hooks/**/*.test.ts",
          "<rootDir>/src/hooks/**/*.test.tsx",
          "<rootDir>/src/i18n/**/*.test.ts",
          "<rootDir>/src/i18n/**/*.test.tsx",
          "<rootDir>/src/appConfig.test.ts",
          "<rootDir>/src/game/save/uniqueUids.test.ts",
          "<rootDir>/src/game/patrols/pocketPassive.test.ts",
          "<rootDir>/src/game/expeditions/oddsCache.test.ts",
          "<rootDir>/src/game/expeditions/odds.test.ts"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/\\.worktrees/"
        ]
      },
      {
        "displayName": "perf",
        "preset": "jest-expo",
        "setupFiles": [
          "./jest.setup.ts"
        ],
        "testMatch": [
          "<rootDir>/src/perf/**/*.test.ts",
          "<rootDir>/src/perf/**/*.test.tsx",
          "<rootDir>/src/game/expeditions/oddsPerf.test.ts"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/\\.worktrees/"
        ]
      },
      {
        "displayName": "sim",
        "testEnvironment": "node",
        "transform": {
          "^.+\\.(t|j)sx?$": [
            "@swc/jest",
            {
              "jsc": {
                "parser": {
                  "syntax": "typescript",
                  "tsx": true
                },
                "target": "es2022"
              },
              "module": {
                "type": "commonjs"
              }
            }
          ],
          "^.+\\.(png|jpg|jpeg|gif|webp|svg|bmp|avif|heic|ttf|otf|woff|woff2|mp3|wav|m4a|mp4|pdf|html)$": "jest-expo/src/preset/assetFileTransformer.js"
        },
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        },
        "testMatch": [
          "<rootDir>/src/game/sim/sim.test.ts",
          "<rootDir>/src/game/sim/quick.test.ts"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/\\.worktrees/"
        ]
      }
    ]
  }
}
