{
  "name": "pocket-quartermaster",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@mapbox/vector-tile": "^1.3.1",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-sensors": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.12",
    "ngeohash": "^0.6.4",
    "pbf": "^3.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-pager-view": "9.0.7",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "seedrandom": "^3.0.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mapbox__vector-tile": "^1.3.4",
    "@types/ngeohash": "^0.6.8",
    "@types/pbf": "^3.0.5",
    "@types/react": "~19.3.0",
    "@types/seedrandom": "^3.0.8",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:fresh": "expo prebuild --platform android --clean && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "sim": "node scripts/sim/build.mjs && node sim-output/.build/sim.cjs",
    "sim:quick": "node scripts/sim/build.mjs && node sim-output/.build/quick.cjs",
    "sim:check": "npm run sim && SIM_CHECK=1 jest src/game/sim/bands.test.ts",
    "loot:matrix": "tsx scripts/loot/genMatrix.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\.worktrees/"
    ]
  }
}
